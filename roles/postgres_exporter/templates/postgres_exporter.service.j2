# {{ ansible_managed }}
[Unit]
Description=Prometheus PostgreSQL exporter
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=exec
User=postgres_exporter
Group=postgres_exporter
# No password: peer authentication over the socket (see defaults/main.yml).
Environment="DATA_SOURCE_NAME=host={{ postgres_exporter_socket_dir }} port={{ postgres_exporter_postgresql_port }} user=postgres_exporter dbname=postgres sslmode=disable"
ExecStart=/opt/postgres_exporter-{{ postgres_exporter_version }}/postgres_exporter \
    --web.listen-address={{ postgres_exporter_listen_address }}:{{ postgres_exporter_port }}
Restart=on-failure
RestartSec=2

# --- Sandboxing ---
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0077

[Install]
WantedBy=multi-user.target
